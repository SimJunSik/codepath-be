# Application
APP_NAME=CodePath Backend
APP_VERSION=0.1.0
DEBUG=True
ENVIRONMENT=development

# Server
HOST=0.0.0.0
PORT=8000

# Database
DATABASE_URL=postgresql+asyncpg://codepath:codepath123@localhost:5432/codepath
DATABASE_ECHO=False
AUTO_CREATE_DB=True

# Redis
REDIS_URL=redis://localhost:6379/0

# Security
SECRET_KEY=your-secret-key-change-this-in-production-min-32-chars
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# CORS
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173"]

# Code Execution
CODE_EXECUTION_TIMEOUT=5
CODE_EXECUTION_MAX_OUTPUT=10000

# AWS Lambda Code Executor
USE_LAMBDA_EXECUTOR=True
CODE_EXECUTOR_LAMBDA_NAME=codepath-code-executor
AWS_REGION=ap-northeast-2

# Rate Limiting
RATE_LIMIT_PER_MINUTE=60

# Admin bootstrap (optional)
ADMIN_EMAIL=
ADMIN_USERNAME=
ADMIN_PASSWORD=
ADMIN_FULL_NAME=

# LLM Evaluation
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini
LLM_EXPLANATION_PASS_SCORE=90
LLM_EXPLANATION_TIMEOUT_SECONDS=20
